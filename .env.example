GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PROVIDER=
TARGET_DIR=../ecommerce-microservices
COMPOSE_PROJECT=ecommerce-microservices
AUTH_URL=http://localhost:3004
PRODUCT_URL=http://localhost:3002
ORDER_URL=http://localhost:3003
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=ecommerce123
RABBITMQ_VHOST=/
SEED_USERS=20
# Local load-test accounts only; retain their existing password when rerunning seed.
SEED_PASSWORD=ChaosPilotTest123!
# Existing admin password; blank falls back to SEED_PASSWORD for new/default admins.
ADMIN_PASSWORD=
AUTH_TIMEOUT_S=4
REQUEST_TIMEOUT_S=10
NOTIFICATION_INTERVAL_S=6

# Phase 4 live load and baseline (checkout creates durable orders/notifications).
FRONTEND_URL=http://localhost:3000
LOAD_USERS=10
LOAD_DURATION_S=30
LOAD_TIMEOUT_S=5
CHECKOUT_RPS=1
# Auth has a shared 100 requests/15-minute IP limit; cap at 90 with headroom.
AUTH_RPS=0.1
TOKEN_REFRESH_S=600
THINK_MIN_S=0.2
THINK_MAX_S=1.0
METRICS_INTERVAL_S=5
WARMUP_S=30
BASELINE_DURATION_S=120
